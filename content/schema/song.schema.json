{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ymatrix1/easy-piano/content/schema/song.schema.json",
  "title": "Easy Piano song",
  "description": "Editor help only; `content lint` is the source of truth (bar lengths, notation, licenses).",
  "type": "object",
  "required": [
    "id",
    "title",
    "composer",
    "arranger",
    "source",
    "license",
    "composition_license",
    "bpm",
    "time",
    "key",
    "bars"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "composer": {
      "type": "string",
      "minLength": 1
    },
    "arranger": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "public-domain"
      ]
    },
    "composition_license": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "public-domain"
      ]
    },
    "bpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 300
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]+/[0-9]+$"
    },
    "key": {
      "type": "string"
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "RH": {
            "type": "string"
          },
          "LH": {
            "type": "string"
          }
        }
      }
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": false
}
