# Cloudflare Pages headers. COOP/COEP make the page cross-origin isolated,
# which the Rust/wasm core (flutter_rust_bridge, SharedArrayBuffer) needs.
# Entry points (index.html, flutter_bootstrap.js, service worker) keep the
# Pages default (revalidate), so a deploy shows up right away.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=3600
/canvaskit/*
  Cache-Control: public, max-age=86400
/pkg/*
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=86400
